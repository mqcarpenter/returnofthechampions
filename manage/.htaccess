# Deny direct access to config.php and any stray backup/editor files that
# might get created next to it (config.php~, config.php.bak, config.php.save).
# These would otherwise be served as plain text instead of executed as PHP,
# which is how a real API key ends up leaked.
<FilesMatch "^config\.php(~|\.bak|\.save)?$|^\.env">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# templates/ and includes/ are PHP fragments meant to be include()'d by
# index.php etc — they reference variables the caller sets up first, so
# hitting them directly throws PHP notices instead of a real page. Block
# direct requests; index.php and friends still include() them fine since
# that's a filesystem read, not an HTTP request.
# Serve index.php for a directory request (e.g. /mobile -> mobile/index.php).
# Set explicitly so the /mobile folder route doesn't depend on the host's
# default DirectoryIndex including index.php.
DirectoryIndex index.php index.html

RewriteEngine On
RewriteRule ^(templates|includes)/ - [F,L]

# Clean URLs, foldered by nav section: /transactions/rosters ->
# transactions/rosters.php, /scores/standings -> scores/standings.php,
# etc. Checked before the single-segment rule below since a request
# only matches one of the two patterns.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/([a-z0-9-]+)/?$ $1/$2.php [L,QSA]

# Compress text responses (HTML, CSS, JS, JSON, XML, SVG) -- cuts CSS and
# large roster/standings HTML transfers by ~75-85% over the wire.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Long-lived browser caching for static assets (CSS already uses ?v=filemtime
# cache busting in header.php and rotc-theme/functions.php).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Clean URLs for the tab bar and index.php-adjacent top-level pages:
# /standings -> standings.php, etc. Only kicks in when no real
# file/directory matches the request, so /assets/mfl26.css and
# /api/matchup-ticker.php are untouched.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ $1.php [L,QSA]
