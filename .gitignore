# This repo mirrors the site's document root -- the whole thing, one
# site, one repo. It tracks wp-content/ (custom themes, plugins,
# uploads), the one custom root index.php, /manage/ (the non-WordPress
# fantasy-management app, same site, same server, same docroot), and
# this .cpanel.yml. WordPress core (wp-admin, wp-includes, every OTHER
# root wp-*.php file, wp-config.php) is vendor code / secrets --
# trivially reinstalled or never meant to leave the server, not
# something tracked here.
/*
!/.gitignore
!/wp-content
!/index.php
!/manage
!/.cpanel.yml

# The backup archives themselves must never be committed -- these are
# multi-hundred-MB tar/zip files, not source content.
wp-content/backuply/
wp-content/backups-dup-lite/

# WordPress core, plugin, and cache-generated data, none of it source.
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/litespeed/

.DS_Store
